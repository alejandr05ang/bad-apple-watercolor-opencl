<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal: a la izquierda las dos vistas (original | efecto) y las métricas;
     a la derecha el panel de controles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#101010"
    android:keepScreenOn="true"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original"
                    android:textColor="#FFD54F"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/imgOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Original" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">
                <TextView
                    android:id="@+id/txtEtapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resultado final"
                    android:textColor="#FFD54F"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/imgResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Resultado" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtMetricas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:text="Iniciando..." />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp">

        <LinearLayout
            android:id="@+id/panelControles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pipeline"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/grupoModo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/modoCPU" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="CPU" />
                <RadioButton android:id="@+id/modoGPU" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="GPU" />
                <RadioButton android:id="@+id/modoAmbos" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Ambos"
                    android:checked="true" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Vista derecha"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spinnerEtapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnCamara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cambiar cámara" />

            <!-- Los sliders de kernels se agregan desde MainActivity -->
        </LinearLayout>
    </ScrollView>
</LinearLayout>
